root   ::= "{\"items\":[" ( item ( "," item )* )? "]}"
item   ::= "{\"food\":" str ",\"brand\":" str ",\"qty\":" num ",\"unit\":" unit ",\"size\":" size ",\"state\":" state ",\"prep\":" str "}"
str    ::= "\"" char* "\""
char   ::= [^"\\\x00-\x1f] | "\\" ["\\/bfnrtu]
num    ::= [0-9]+ ( "." [0-9]+ )?
unit   ::= "\"g\"" | "\"kg\"" | "\"oz\"" | "\"lb\"" | "\"ml\"" | "\"l\"" | "\"fl_oz\"" | "\"tbsp\"" | "\"tsp\"" | "\"cup\"" | "\"slice\"" | "\"piece\"" | "\"bowl\"" | "\"plate\"" | "\"handful\"" | "\"clove\"" | "\"can\"" | "\"bottle\"" | "\"glass\"" | "\"pint\"" | "\"serving\"" | "\"scoop\"" | "\"shot\""
size   ::= "\"\"" | "\"small\"" | "\"medium\"" | "\"large\"" | "\"extra large\""
state  ::= "\"\"" | "\"raw\"" | "\"cooked\""
